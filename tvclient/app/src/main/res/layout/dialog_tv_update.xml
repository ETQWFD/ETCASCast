<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="600dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_udl_card"
    android:orientation="vertical"
    android:padding="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/udl_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/udl_title"
                android:textColor="#F4F8FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/udl_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#A9C2E8"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/udl_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#7FB3F5"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/udl_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/udl_progress" />

    <TextView
        android:id="@+id/udl_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#F4F8FF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/udl_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/udl_connecting"
        android:textColor="#A9C2E8"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/udl_btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/udl_btn_accent"
            android:focusable="true"
            android:minWidth="150dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/udl_retry"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/udl_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/udl_btn_ghost"
            android:focusable="true"
            android:minWidth="150dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/udl_cancel"
            android:textColor="#7FB3F5" />
    </LinearLayout>
</LinearLayout>
